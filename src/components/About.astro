---
// src/components/About.astro
// Founder & Leadership Section for Chand Zaib
// Aligned under the Hero section with transparent portrait and typewriter assets

const partnerLogos = [
  {
    name: 'ALMATAR',
    src: '/logos/Almatar-logo.avif',
    alt: 'ALMATAR Oil and Energy Partner',
    heightClass: 'h-8 sm:h-9 md:h-10 w-auto',
  },
  {
    name: 'B.Royals Barbershop',
    src: '/logos/barber-shop-logo-transparent.webp',
    alt: 'B.Royals Barbershop Germany',
    heightClass: 'h-8 sm:h-9 md:h-10 w-auto',
  },
  {
    name: 'Fisch Levy',
    src: '/logos/fisch-levy-logo.webp',
    fallbackSrc: '/logos/fisch-levy-logo.png',
    alt: 'Fisch Levy Germany',
    heightClass: 'h-8 sm:h-9 md:h-10 w-auto',
  },
  {
    name: 'NBMH',
    src: '/logos/NBMH-logo.webp',
    alt: 'Nazeer Begum Memorial Hospital Pakistan',
    heightClass: 'h-8 sm:h-9 md:h-10 w-auto',
  },
  {
    name: 'NTDH',
    src: '/logos/NTDH-logo.webp',
    fallbackSrc: '/logos/NTDH-logo.png',
    alt: 'NTDH International Energy Partner',
    heightClass: 'h-7 sm:h-8 md:h-9 w-auto',
  },
  {
    name: 'Sevpark',
    src: '/logos/sevpark-logo.webp',
    fallbackSrc: '/logos/sevpark-logo.png',
    alt: 'Sevpark Smart Parking Systems',
    heightClass: 'h-6 sm:h-7 md:h-8 w-auto',
  },
  {
    name: 'Smart Worker',
    src: '/logos/smart-worker-logo.webp',
    alt: 'Smart Worker Digital Platform',
    heightClass: 'h-8 sm:h-9 md:h-10 w-auto',
  },
];
---

<section
  id="about"
  class="relative w-full bg-[#F6F5F1] py-16 sm:py-20 lg:py-28 px-6 sm:px-10 lg:px-16 border-t border-black/10 overflow-hidden"
  aria-label="About Chand Zaib"
>
  <!-- Background ambient grid pattern for seamless continuity with Hero -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40 [background-image:linear-gradient(to_right,rgba(0,0,0,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.04)_1px,transparent_1px)] [background-size:48px_48px]"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
      
      <!-- ============================================================
           LEFT COLUMN: Name heading, biographical copy, typewriter icon
           ============================================================ -->
      <div class="lg:col-span-7 flex flex-col justify-center z-10">
        
        <!-- Large Stacked Name Heading -->
        <h2 class="font-display font-black text-6xl sm:text-7xl lg:text-8xl tracking-tight leading-[0.92] text-[#0B0B0B] mb-8 select-none">
          <span class="block">Chand</span>
          <span class="block">Zaib</span>
        </h2>

        <!-- Biography Body Copy -->
        <div class="space-y-5 text-sm sm:text-base text-[#0B0B0B]/85 leading-relaxed font-normal max-w-xl">
          <p>
            <strong class="font-semibold text-[#0B0B0B]">Hello, I'm Chand Zaib.</strong><br />
            Full-stack software developer and digital marketing strategist helping global brands scale through custom tech and high-converting campaigns.
          </p>

          <p>
            I have partnered with international oil companies <strong class="font-semibold text-[#0B0B0B]">ALMATAR</strong> and <strong class="font-semibold text-[#0B0B0B]">NTDH</strong>, as well as leading German businesses including <strong class="font-semibold text-[#0B0B0B]">Taverne Kostas</strong> (Greek restaurant), <strong class="font-semibold text-[#0B0B0B]">B.Royals Barbershop</strong>, and <strong class="font-semibold text-[#0B0B0B]">Fisch Levy</strong>.
          </p>

          <p>
            My portfolio also spans USA real estate with <strong class="font-semibold text-[#0B0B0B]">DevHawk</strong> and healthcare systems for <strong class="font-semibold text-[#0B0B0B]">Nazeer Begum Hospital</strong> in Pakistan—blending engineering with digital marketing for real growth.
          </p>
        </div>

        <!-- Vintage Typewriter Sticker Icon -->
        <div class="mt-8 pt-2">
          <picture>
            <source srcset="/images/typewriter.webp" type="image/webp" />
            <img
              src="/images/typewriter.png"
              alt="Vintage typewriter representing craftsmanship, engineering, and storytelling"
              width="177"
              height="97"
              class="w-28 sm:w-36 md:w-40 h-auto object-contain select-none transition-transform duration-300 hover:scale-105 filter drop-shadow-md"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>

      <!-- ============================================================
           RIGHT COLUMN: Transparent portrait cutout of Chand Zaib
           ============================================================ -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end items-end relative z-10">
        
        <!-- Subtle warm ambient aura behind the cutout portrait -->
        <div
          class="absolute w-64 h-64 sm:w-80 sm:h-80 rounded-full bg-gradient-to-tr from-[#D96B43]/15 via-amber-200/20 to-orange-100/10 blur-3xl pointer-events-none -z-10"
          aria-hidden="true"
        ></div>

        <!-- Transparent Cutout Portrait Image -->
        <div class="relative w-full max-w-[340px] sm:max-w-[400px] lg:max-w-[430px] flex justify-center">
          <picture>
            <source srcset="/images/profile.webp" type="image/webp" />
            <img
              src="/images/profile.png"
              alt="Chand Zaib — Full-stack developer and digital marketing strategist"
              width="400"
              height="400"
              class="w-full h-auto object-contain select-none filter drop-shadow-xl transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>

      </div>

    </div>

    <!-- ============================================================
         PARTNER & CLIENT LOGOS MARQUEE (Right-to-Left Continuous Loop)
         Positioned under profile photo & founder bio
         ============================================================ -->
    <div class="mt-10 sm:mt-12 lg:mt-14 pt-6 sm:pt-8 border-t border-black/10">
      
      <!-- Seamless Overflow-Hidden Marquee Track with Edge Fade Mask -->
      <div
        class="marquee-container -mx-6 sm:-mx-10 lg:-mx-16 relative overflow-hidden select-none py-2 marquee-mask"
        role="region"
        aria-label="Partner and client logos carousel"
      >
        <div class="marquee-track flex w-max items-center">
          
          <!-- Track Set 1 (14 logos) -->
          <div class="flex items-center gap-12 sm:gap-16 lg:gap-20 pr-12 sm:pr-16 lg:pr-20">
            {partnerLogos.map((logo) => (
              <div class="logo-item flex items-center justify-center shrink-0">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class={`${logo.heightClass} max-w-[140px] sm:max-w-[170px] object-contain transition-all duration-300 opacity-80 hover:opacity-100 hover:scale-105`}
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))}
            {partnerLogos.map((logo) => (
              <div class="logo-item flex items-center justify-center shrink-0" aria-hidden="true">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class={`${logo.heightClass} max-w-[140px] sm:max-w-[170px] object-contain transition-all duration-300 opacity-80 hover:opacity-100 hover:scale-105`}
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))}
          </div>

          <!-- Track Set 2 (14 logos for seamless -50% loop translation) -->
          <div class="flex items-center gap-12 sm:gap-16 lg:gap-20 pr-12 sm:pr-16 lg:pr-20" aria-hidden="true">
            {partnerLogos.map((logo) => (
              <div class="logo-item flex items-center justify-center shrink-0">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class={`${logo.heightClass} max-w-[140px] sm:max-w-[170px] object-contain transition-all duration-300 opacity-80 hover:opacity-100 hover:scale-105`}
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))}
            {partnerLogos.map((logo) => (
              <div class="logo-item flex items-center justify-center shrink-0">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class={`${logo.heightClass} max-w-[140px] sm:max-w-[170px] object-contain transition-all duration-300 opacity-80 hover:opacity-100 hover:scale-105`}
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll 30s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Elegant edge fade masks */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      transparent 100%
    );
  }

  @media (max-width: 640px) {
    .marquee-mask {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 1) 4%,
        rgba(0, 0, 0, 1) 96%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 1) 4%,
        rgba(0, 0, 0, 1) 96%,
        transparent 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
    }
  }
</style>
