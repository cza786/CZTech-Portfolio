---
// src/components/Hero.astro
// Responsive, high-performance Hero Section for CZTech Software & AI Agency
// Powered by json-render +jev (JSON Evaluator Value / Declarative Generative UI)

import defaultSpec from '../data/hero-spec.json';
import { evaluateHeroSpec, type JevHeroSpec } from '../lib/json-render-jev';
import { projects } from '../data/projects';

interface Props {
  spec?: Partial<JevHeroSpec>;
}

const { spec: customSpec } = Astro.props;
// Evaluate and normalize spec via JEV runtime evaluator
const spec = evaluateHeroSpec({ ...defaultSpec, ...customSpec });

const { brand, navLinks, layers, headline, stickers, cta } = spec;
const { grid, sky, vectorLines } = layers;
---

<section
  id="hero"
  class="hero-container min-h-screen w-full relative overflow-hidden flex flex-col justify-between select-none"
  aria-label={`${brand.name} Hero`}
  data-json-render="v1"
  data-jev-model={spec.jev.model}
  data-jev-target={spec.jev.target}
>
  <!-- ============================================================
       LAYER 1: Off-White Grid Base (z-0)
       Subtle 48px x 48px square grid lines in rgba(0, 0, 0, 0.05)
       ============================================================ -->
  {grid.enabled && (
    <div
      class="absolute inset-0 z-0 pointer-events-none hero-grid-bg"
      aria-hidden="true"
      data-jev-layer="grid"
    />
  )}

  <!-- ============================================================
       LAYER 2: Faded Sunset Sky (z-10)
       Anchored to top with CSS mask-image linear gradient
       Optimized WebP format with eager high-priority LCP loading
       ============================================================ -->
  <div
    class="absolute top-0 left-0 w-full h-[42%] z-10 pointer-events-none overflow-hidden hero-sky-mask"
    aria-hidden="true"
    data-jev-layer="sky"
  >
    <picture>
      <source srcset={sky.src} type="image/webp" />
      <img
        src={sky.src}
        alt={sky.alt}
        width={sky.width}
        height={sky.height}
        class="w-full h-full object-cover object-top select-none"
        loading={sky.loading}
        fetchpriority={sky.fetchpriority}
        decoding="async"
      />
    </picture>
  </div>

  <!-- ============================================================
       LAYER 3: Looping Vector Line Art (z-10)
       Thin, organic looping Bezier curves weaving behind text & stickers
       ============================================================ -->
  {vectorLines.enabled && (
    <svg
      class="absolute inset-0 w-full h-full z-10 pointer-events-none"
      viewBox={vectorLines.viewBox}
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
      aria-hidden="true"
      data-jev-layer="vector-lines"
    >
      {vectorLines.curves.map((curve) => (
        <path
          d={curve.d}
          stroke={vectorLines.stroke}
          stroke-width={vectorLines.strokeWidth}
          opacity={curve.opacity}
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray={curve.dashArray}
        />
      ))}
    </svg>
  )}

  <!-- ============================================================
       LAYER 4: Top-Left Brand Wordmark (z-30)
       Positioned at top-6 left-6 md:left-8 in bold black #0B0B0B
       ============================================================ -->
  <header class="absolute top-6 left-6 md:left-8 z-30" data-jev-element="brand">
    <a
      href={brand.href}
      class="text-[#0B0B0B] text-2xl md:text-3xl font-extrabold tracking-tight font-display hover:opacity-80 transition-opacity inline-flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D96B43] rounded"
      aria-label={brand.label}
    >
      <span>{brand.name}</span>
    </a>
  </header>

  <!-- Optional Top-Right Nav pill for desktop UX polish -->
  {navLinks && navLinks.length > 0 && (
    <nav
      class="hidden md:flex absolute top-7 right-10 z-30 items-center gap-6 font-mono text-xs font-bold tracking-wider uppercase text-[#0B0B0B]"
      aria-label="Hero navigation"
      data-jev-element="nav-links"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={
            link.isPill
              ? "px-3.5 py-1.5 rounded-full border border-black/15 bg-white/70 backdrop-blur-sm shadow-sm hover:border-black transition-all"
              : "hover:text-[#D96B43] transition-colors"
          }
        >
          {link.label}
        </a>
      ))}
    </nav>
  )}

  <!-- ============================================================
       LAYER 6: 5 Floating Transparent Service Stickers (z-20)
       Lightweight WebP images with hardware-accelerated 3D float
       ============================================================ -->
  {stickers.map((sticker) => (
    <div
      class={`sticker-wrapper ${sticker.posClass} z-20 pointer-events-auto`}
      title={sticker.name}
      data-jev-sticker={sticker.id}
    >
      <div class={sticker.animClass}>
        <picture>
          <source srcset={sticker.src} type="image/webp" />
          <img
            src={sticker.fallbackSrc || sticker.src}
            alt={sticker.alt}
            width={sticker.width}
            height={sticker.height}
            class={`sticker-cutout-light ${sticker.sizeClass} h-auto cursor-pointer select-none`}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  ))}

  <!-- ============================================================
       LAYER 5: Center Hero Typography + Inline UI Card (z-20)
       Vertically & horizontally centered container
       ============================================================ -->
  <div
    class="relative z-20 flex-1 flex flex-col items-center justify-center text-center px-4 max-w-6xl mx-auto w-full pt-20 pb-24 md:py-0"
    data-jev-element="headline-container"
  >
    <h1 class="font-display font-black uppercase text-[#0B0B0B] tracking-[-0.03em] leading-[1.05] text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[5.25rem] flex flex-col items-center justify-center">
      <!-- Line 1: Flex row with AI AGENTS + Interactive Tablet Presentation + SOFTWARE -->
      <span class="inline-flex items-center justify-center flex-wrap gap-x-3 sm:gap-x-5 md:gap-x-6 gap-y-2">
        <!-- AI AGENTS with Kinetic Wave Character Rise -->
        <span class="whitespace-nowrap inline-flex">
          {"AI AGENTS".split('').map((char, i) => (
            char === ' ' ? (
              <span class="inline-block w-[0.28em]">&nbsp;</span>
            ) : (
              <span class="inline-block overflow-hidden pb-1">
                <span class="hero-char inline-block" style={`--char-index: ${i}; --char-delay-base: 80ms;`}>{char}</span>
              </span>
            )
          ))}
        </span>
        
        <!-- Interactive Tablet Presentation Showcase (Looping Works Screens: Left & Right Alternating) -->
        <a
          href="#work"
          id="hero-tablet-showcase"
          class="relative inline-flex items-center mx-1 md:mx-2 align-middle group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D96B43] rounded-xl"
          title="Click to view full Works & Case Studies"
          aria-label="Interactive Presentation of Featured Works"
        >
          <!-- Outer Tablet Hardware Bezel -->
          <div class="relative w-32 sm:w-40 md:w-48 lg:w-56 aspect-[334/233] rounded-[14px] sm:rounded-[18px] md:rounded-[22px] bg-gradient-to-b from-[#e8e9ec] via-[#f4f5f7] to-[#cfd2d7] p-[3px] sm:p-[4px] md:p-[5px] shadow-xl border border-black/15 transition-transform duration-300 group-hover:scale-105 select-none">
            
            <!-- Camera / Sensor Dot at Top Bezel -->
            <div class="absolute top-[3px] sm:top-[4px] left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-neutral-700/60 z-30 pointer-events-none"></div>

            <!-- Inner Screen Bezel & Display Area -->
            <div class="relative w-full h-full rounded-[10px] sm:rounded-[13px] md:rounded-[16px] bg-[#0c0d10] overflow-hidden">
              
              <!-- Slides Container -->
              <div class="relative w-full h-full overflow-hidden" id="hero-tablet-slides">
                {projects.map((project, idx) => (
                  <div
                    class="tablet-slide absolute inset-0 w-full h-full pointer-events-none"
                    data-slide-index={idx}
                    data-project-id={project.id}
                    style={idx === 0 ? "transform: translateX(0%); opacity: 1; z-index: 10;" : "transform: translateX(100%); opacity: 0; z-index: 0;"}
                  >
                    <!-- Slide Image -->
                    <div class="w-full h-full flex items-center justify-center bg-[#F6F5F1] overflow-hidden relative">
                      <img
                        src={project.heroImage}
                        alt={`${project.title} Interface`}
                        class="w-full h-full object-cover object-top select-none"
                        loading={idx === 0 ? "eager" : "lazy"}
                        fetchpriority={idx === 0 ? "high" : "auto"}
                        decoding={idx === 0 ? "sync" : "async"}
                      />
                      
                      <!-- Subtle Bottom Gradient with Project Title Badge -->
                      <div class="absolute inset-x-0 bottom-0 h-6 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex items-end justify-between px-2 pb-1 pointer-events-none">
                        <span class="text-[8px] sm:text-[9px] md:text-[10px] font-display font-bold text-white tracking-wide truncate drop-shadow-sm">
                          {project.title}
                        </span>
                        <span class="text-[7px] sm:text-[8px] font-mono text-white/70">
                          {idx + 1}/{projects.length}
                        </span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Sleek Screen Glass Reflection Sheen Overlay -->
              <div class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-transparent via-white/[0.08] to-transparent z-20"></div>

              <!-- Animated Progress Bar at bottom of screen -->
              <div class="absolute bottom-0 inset-x-0 h-[2px] bg-white/20 z-30 pointer-events-none">
                <div id="hero-tablet-progress" class="h-full bg-[#D96B43] w-0"></div>
              </div>

            </div>
          </div>
        </a>

        <!-- SOFTWARE with Kinetic Wave Character Rise -->
        <span class="whitespace-nowrap inline-flex">
          {"SOFTWARE".split('').map((char, i) => (
            char === ' ' ? (
              <span class="inline-block w-[0.28em]">&nbsp;</span>
            ) : (
              <span class="inline-block overflow-hidden pb-1">
                <span class="hero-char inline-block" style={`--char-index: ${i}; --char-delay-base: 420ms;`}>{char}</span>
              </span>
            )
          ))}
        </span>
      </span>

      <!-- Line 2: SMART TECH, REAL GROWTH. with Undulating Wavy Rise (Never Breaks Words) -->
      <span class="block mt-2 sm:mt-3 md:mt-4 inline-flex justify-center flex-wrap gap-x-3 sm:gap-x-4">
        {("SMART TECH, REAL GROWTH.".split(' ')).map((word, wordIdx, wordsArr) => {
          const priorLen = wordsArr.slice(0, wordIdx).join(' ').length + (wordIdx > 0 ? 1 : 0);
          return (
            <span class="whitespace-nowrap inline-flex">
              {word.split('').map((char, charIdx) => {
                const globalIdx = priorLen + charIdx;
                return (
                  <span class="inline-block overflow-hidden pb-1">
                    <span class="hero-char inline-block" style={`--char-index: ${globalIdx}; --char-delay-base: 720ms;`}>{char}</span>
                  </span>
                );
              })}
            </span>
          );
        })}
      </span>
    </h1>

    <p class="sr-only">
      {headline.srDescription}
    </p>
  </div>

  <!-- ============================================================
       LAYER 7: Bottom-Center CTA (z-30)
       Anchor link EXPLORE CZTECH smoothly scrolling to #services
       ============================================================ -->
  <footer class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 pb-1" data-jev-element="cta">
    <a
      href={cta.href}
      class="group font-mono text-xs md:text-sm font-bold tracking-[0.15em] uppercase text-[#0B0B0B] hover:opacity-70 transition-all inline-flex items-center gap-2 py-1 px-3 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D96B43]"
      aria-label={cta.ariaLabel}
    >
      <span>{cta.text}</span>
      <svg
        class="w-3.5 h-3.5 text-[#0B0B0B] transition-transform duration-300 group-hover:translate-y-0.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </footer>
</section>

<style>
  /* ============================================================
     Layer 1 Grid Background
     ============================================================ */
  .hero-grid-bg {
    background-color: #F6F5F1;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  /* ============================================================
     Layer 2 Sunset Sky Mask
     ============================================================ */
  .hero-sky-mask {
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 65%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 65%);
  }

  /* ============================================================
     Kinetic Wave Character-by-Character Rise Animation
     Letters rise in an undulating curved wave (staggered delay)
     ============================================================ */
  @keyframes heroLetterRise {
    0% {
      opacity: 0;
      transform: translateY(115%) rotate(4deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0%) rotate(0deg);
    }
  }

  .hero-char {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity;
    animation: heroLetterRise 1.05s cubic-bezier(0.22, 0.8, 0.25, 1) forwards;
    animation-delay: calc(var(--char-delay-base, 80ms) + var(--char-index) * 36ms);
  }

  /* ============================================================
     Layer 6 Lightweight Hardware-Accelerated Sticker Cutout
     Uses GPU-composited drop-shadow and 3D transforms for 60fps
     ============================================================ */
  .sticker-cutout-light {
    /* Baked crisp white border + terracotta edge in WebP; single soft elevation filter */
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.12));
    transform: translate3d(0, 0, 0);
    will-change: transform;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), filter 0.3s ease;
  }

  .sticker-cutout-light:hover {
    transform: translate3d(0, -6px, 0) scale(1.06);
    filter: drop-shadow(0 14px 22px rgba(217, 107, 67, 0.22)) drop-shadow(0 4px 8px rgba(0,0,0,0.08));
  }

  /* ============================================================
     Desktop Absolute Positions for the 5 Stickers
     ============================================================ */
  .sticker-wrapper {
    position: absolute;
    transform: translate3d(0, 0, 0);
  }

  /* 1. Top-Left: top-[8%] left-[4%] */
  .sticker-pos-1 {
    top: 8%;
    left: 4%;
  }

  /* 2. Top-Right: top-[4%] right-[3%] */
  .sticker-pos-2 {
    top: 4%;
    right: 3%;
  }

  /* 3. Bottom-Left: bottom-[4%] left-[4%] */
  .sticker-pos-3 {
    bottom: 4%;
    left: 4%;
  }

  /* 4. Bottom-Center: bottom-[7%] left-1/2 -translate-x-1/2 */
  .sticker-pos-4 {
    bottom: 7%;
    left: 50%;
    transform: translate3d(-50%, 0, 0);
  }

  /* 5. Bottom-Right: bottom-[4%] right-[4%] */
  .sticker-pos-5 {
    bottom: 4%;
    right: 4%;
  }

  /* ============================================================
     Subtle, Lightweight GPU-Accelerated Float Keyframes
     Strictly animates translate3d() and rotate() on compositor thread
     ============================================================ */
  .sticker-anim-1 {
    animation: float-1 7.2s ease-in-out infinite;
    will-change: transform;
  }

  .sticker-anim-2 {
    animation: float-2 8s ease-in-out infinite 0.6s;
    will-change: transform;
  }

  .sticker-anim-3 {
    animation: float-3 6.8s ease-in-out infinite 1.2s;
    will-change: transform;
  }

  .sticker-anim-4 {
    animation: float-4 7.6s ease-in-out infinite 0.4s;
    will-change: transform;
  }

  .sticker-anim-5 {
    animation: float-5 8.2s ease-in-out infinite 1.8s;
    will-change: transform;
  }

  @keyframes float-1 {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(-6deg);
    }
    50% {
      transform: translate3d(0, -9px, 0) rotate(-4.5deg);
    }
  }

  @keyframes float-2 {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(6deg);
    }
    50% {
      transform: translate3d(0, -11px, 0) rotate(7.5deg);
    }
  }

  @keyframes float-3 {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(-3deg);
    }
    50% {
      transform: translate3d(0, -8px, 0) rotate(-1.5deg);
    }
  }

  @keyframes float-4 {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(0, -10px, 0) rotate(1deg);
    }
  }

  @keyframes float-5 {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(3deg);
    }
    50% {
      transform: translate3d(0, -10px, 0) rotate(4.5deg);
    }
  }

  /* ============================================================
     Clean Mobile & Tablet Responsiveness
     ============================================================ */
  @media (max-width: 1024px) {
    .sticker-pos-1 {
      top: 9%;
      left: 2%;
    }
    .sticker-pos-2 {
      top: 6%;
      right: 2%;
    }
    .sticker-pos-3 {
      bottom: 5%;
      left: 2%;
    }
    .sticker-pos-4 {
      bottom: 8%;
    }
    .sticker-pos-5 {
      bottom: 5%;
      right: 2%;
    }
  }

  @media (max-width: 768px) {
    .sticker-pos-1 {
      top: 12%;
      left: 3%;
    }
    .sticker-pos-2 {
      top: 10%;
      right: 3%;
    }
    .sticker-pos-3 {
      bottom: 7%;
      left: 3%;
    }
    .sticker-pos-4 {
      bottom: 12%;
      left: 50%;
    }
    .sticker-pos-5 {
      bottom: 7%;
      right: 3%;
    }
  }

  @media (max-width: 480px) {
    .sticker-pos-1 {
      top: 11%;
      left: 1%;
    }
    .sticker-pos-2 {
      top: 9%;
      right: 1%;
    }
    .sticker-pos-3 {
      bottom: 8%;
      left: 2%;
    }
    .sticker-pos-4 {
      bottom: 11%;
      left: 50%;
    }
    .sticker-pos-5 {
      bottom: 8%;
      right: 2%;
    }
  }

  /* Accessible motion preference */
  @media (prefers-reduced-motion: reduce) {
    .sticker-anim-1,
    .sticker-anim-2,
    .sticker-anim-3,
    .sticker-anim-4,
    .sticker-anim-5 {
      animation: none !important;
    }
    .sticker-cutout-light {
      transition: none !important;
    }
    .tablet-slide {
      transition: none !important;
    }
  }
</style>

<!-- ============================================================
     CLIENT SCRIPT: Alternating Looping Works Presentation Engine
     One enters from Left, next enters from Right, looping indefinitely
     ============================================================ -->
<script>
  function initTabletPresentation() {
    const container = document.getElementById('hero-tablet-slides');
    const progressBar = document.getElementById('hero-tablet-progress');
    const showcaseLink = document.getElementById('hero-tablet-showcase');
    if (!container) return;

    const slides = Array.from(container.querySelectorAll<HTMLElement>('.tablet-slide'));
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let isPaused = false;
    let timer: any = null;
    const slideDuration = 3200; // 3.2s per slide
    const transitionDuration = 700; // 700ms smooth transition

    // Pause on hover so the visitor can inspect any screen
    if (showcaseLink) {
      showcaseLink.addEventListener('mouseenter', () => {
        isPaused = true;
      });
      showcaseLink.addEventListener('mouseleave', () => {
        isPaused = false;
      });
    }

    function startProgressBar() {
      if (!progressBar) return;
      progressBar.style.transition = 'none';
      progressBar.style.width = '0%';
      void progressBar.offsetWidth; // Force reflow
      progressBar.style.transition = `width ${slideDuration}ms linear`;
      progressBar.style.width = '100%';
    }

    function transitionTo(nextIndex: number) {
      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];
      if (!currentSlide || !nextSlide) return;

      // Alternating Direction Algorithm:
      // When nextIndex is odd (1, 3, 5): enters from RIGHT, current exits to LEFT
      // When nextIndex is even (2, 4, 0): enters from LEFT, current exits to RIGHT
      const enterFromRight = nextIndex % 2 === 1;
      const enterStartTransform = enterFromRight ? 'translateX(100%)' : 'translateX(-100%)';
      const exitEndTransform = enterFromRight ? 'translateX(-100%)' : 'translateX(100%)';

      // Stage next slide at entry position
      nextSlide.style.transition = 'none';
      nextSlide.style.transform = enterStartTransform;
      nextSlide.style.opacity = '1';
      nextSlide.style.zIndex = '15';

      void nextSlide.offsetWidth; // Force layout

      // Animate both slides simultaneously
      const ease = `transform ${transitionDuration}ms cubic-bezier(0.25, 1, 0.5, 1), opacity ${transitionDuration}ms ease`;
      nextSlide.style.transition = ease;
      currentSlide.style.transition = ease;

      currentSlide.style.transform = exitEndTransform;
      currentSlide.style.opacity = '0';
      currentSlide.style.zIndex = '5';

      nextSlide.style.transform = 'translateX(0%)';
      nextSlide.style.opacity = '1';

      setTimeout(() => {
        currentSlide.style.zIndex = '0';
        currentSlide.style.transition = 'none';
        currentIndex = nextIndex;
        startProgressBar();
      }, transitionDuration);
    }

    function scheduleNext() {
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (!isPaused) {
          const nextIndex = (currentIndex + 1) % slides.length;
          transitionTo(nextIndex);
        }
        scheduleNext();
      }, slideDuration);
    }

    // Start presentation loop
    startProgressBar();
    scheduleNext();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabletPresentation);
  } else {
    initTabletPresentation();
  }
</script>
